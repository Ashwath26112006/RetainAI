digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, concentrate=false, fontname="Helvetica", bgcolor="white", pad=0.2];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, dir=both, color="#33415c", penwidth=1.3];

  customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>CUSTOMERS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>customer_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">full_name, email (UQ)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">gender, senior_citizen</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">has_partner, has_dependents</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">signup_date, status</TD></TR></TABLE>>];

  subscriptions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>SUBSCRIPTIONS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>subscription_id</U></TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">customer_id, plan_id,</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">contract_type_id, payment_method_id</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">start_date, end_date, status</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">monthly_charge, paperless_billing</TD></TR></TABLE>>];

  plans [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#2e74b5" COLSPAN="2"><FONT COLOR="white"><B>PLANS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>plan_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">plan_name (UQ), internet_service</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">phone_service, base_price</TD></TR></TABLE>>];

  contract_types [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#2e74b5" COLSPAN="2"><FONT COLOR="white"><B>CONTRACT_TYPES</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>contract_type_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">contract_name (UQ), term_months</TD></TR></TABLE>>];

  payment_methods [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#2e74b5" COLSPAN="2"><FONT COLOR="white"><B>PAYMENT_METHODS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>payment_method_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">method_name (UQ), is_automatic</TD></TR></TABLE>>];

  services [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#2e74b5" COLSPAN="2"><FONT COLOR="white"><B>SERVICES</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>service_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">service_name (UQ), service_category</TD></TR></TABLE>>];

  subscription_services [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f2f2f2">
    <TR><TD BGCOLOR="#7f7f7f" COLSPAN="2"><FONT COLOR="white"><B>SUBSCRIPTION_SERVICES</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>subscription_id</U></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>service_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">added_on</TD></TR></TABLE>>];

  billing_records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>BILLING_RECORDS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>bill_id</U></TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">subscription_id</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">bill_month (UQ with FK), amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status, due_date, paid_date</TD></TR></TABLE>>];

  support_tickets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>SUPPORT_TICKETS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>ticket_id</U></TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">customer_id</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">category, priority, status</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">subject, opened_at, closed_at</TD></TR></TABLE>>];

  churn_scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>CHURN_SCORES</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>customer_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">rule_score, risk_band, segment</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">ml_probability, ml_model, scored_at</TD></TR></TABLE>>];

  retention_actions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>RETENTION_ACTIONS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>action_id</U></TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">customer_id, campaign_id (opt.)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">action_type, action_date, outcome</TD></TR></TABLE>>];

  retention_campaigns [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
    <TR><TD BGCOLOR="#1f3864" COLSPAN="2"><FONT COLOR="white"><B>RETENTION_CAMPAIGNS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>campaign_id</U></TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">campaign_name (UQ), target_segment</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">offer, discount_pct, start/end, status</TD></TR></TABLE>>];

  {rank=same; plans; contract_types; payment_methods;}
  {rank=same; customers; }
  // one(parent) -> many(child)
  customers -> subscriptions [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  plans -> subscriptions [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  contract_types -> subscriptions [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  payment_methods -> subscriptions [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  subscriptions -> billing_records [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  subscriptions -> subscription_services [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  services -> subscription_services [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  customers -> support_tickets [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  customers -> churn_scores [taillabel="1", headlabel="0..1", labeldistance=1.6, arrowtail=teetee, arrowhead=teeodot];
  customers -> retention_actions [taillabel="1", headlabel="N", labeldistance=1.6, arrowtail=teetee, arrowhead=crowodot];
  retention_campaigns -> retention_actions [taillabel="0..1", headlabel="N", labeldistance=1.6, arrowtail=teeodot, arrowhead=crowodot];
}
